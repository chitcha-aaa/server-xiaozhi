# Copy this file to .env and fill in your secrets before running:
#   docker compose up -d --build

APP_ENV=development
PORT=8000
PUBLIC_URL=

# LangMind shared agent
LANGMIND_BASE_URL=https://langmind.in.th/api
LANGMIND_API_KEY=
LANGMIND_AGENT_ID=
VOICE_SPEED=1.0

# Internal Admin Dashboard (/admin)
ADMIN_PASSWORD=change-me-team-password

# Local PostgreSQL (used by docker-compose)
POSTGRES_USER=xiaozhi
POSTGRES_PASSWORD=xiaozhi_local_dev
POSTGRES_DB=xiaozhi
POSTGRES_PORT=5432

# Performance & logging
MAX_FFMPEG_WORKERS=6
LOG_TRANSCRIPT=false
